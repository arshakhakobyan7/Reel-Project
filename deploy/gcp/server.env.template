# Reel on the temporary Google Cloud server (T-1018, D-070). setup.sh fills @...@ once and
# keeps this file owner-only (chmod 600). Never commit the filled file.

# Signs dashboard sessions: a new random value, made on the server.
REEL_WEB_SESSION_SECRET=@SESSION_SECRET@

# The Google OAuth client (copied from the PC, chmod 600).
GOOGLE_CLIENT_SECRETS_FILE=config/google-client.json

# --- settings that differ from the PC (config/reel.toml is the same file) ---------------
REEL__PATHS__FFMPEG=/usr/bin/ffmpeg
REEL__PATHS__FFPROBE=/usr/bin/ffprobe
REEL__PATHS__OLLAMA=tools/ollama/bin/ollama
# Caddy serves HTTPS on 443 and passes requests to Reel on 127.0.0.1:8080.
REEL__WEB__HOST=127.0.0.1
REEL__WEB__PORT=8080
REEL__WEB__TLS=false
REEL__WEB__BASE_URL=https://@HOST@
# OAuth tokens in an owner-only file (there is no Credential Manager on Linux).
REEL__AUTH__STORE=posix
# No Intel GPU on the VM: the LLM and the video run on the CPU.
REEL__LLM__USE_IGPU=false
REEL__RENDER__VIDEO_ENCODER=libx264
REEL__CLEANING__EMPTY_BOARD__HWACCEL=none
