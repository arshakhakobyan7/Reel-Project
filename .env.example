# Secrets for Reel. Copy to .env (or run `reel config init`) and fill in what you use.
# Never commit .env. Real environment variables take precedence over this file.
# `reel config check` tells you which of these the enabled features need.

# Signs staff dashboard sessions (T-802). Optional: when empty, `reel serve` makes one
# and keeps it in Windows Credential Manager. To set your own (at least 32 characters):
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
REEL_WEB_SESSION_SECRET=

# Tokens accepted by Reel's integration API, comma-separated (T-806).
REEL_API_TOKENS=

# Slack bot token (xoxb-...). Needed when slack.mode or notifications.mode = "live".
SLACK_BOT_TOKEN=

# Path to the Google OAuth client JSON from Google Cloud Console.
# Needed when youtube.mode or classroom.mode = "live".
# Desktop app OAuth client file, e.g. config/google-client.json (docs/setup/google.md)
GOOGLE_CLIENT_SECRETS_FILE=

# Core Engine API token. Needed when consent.provider = "http".
CORE_ENGINE_API_TOKEN=

# Academy Library API token. Needed when library.provider = "http".
LIBRARY_API_TOKEN=

# Any setting from config/reel.toml can also be overridden here:
#   REEL__<SECTION>__<KEY>=value      e.g. REEL__WORKERS__COUNT=1
